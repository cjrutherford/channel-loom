# Copy to .env and set a real password. Do not commit .env.

# Host directory holding your library (mounted read-only at /media), and where
# ChannelLoom keeps its database and cache. Both must be readable/writable by
# AWESOMETV_UID:AWESOMETV_GID.
AWESOMETV_MEDIA_PATH=/srv/media
AWESOMETV_DATA_PATH=./data
AWESOMETV_UID=1000
AWESOMETV_GID=1000
# Host port to publish on every interface.
AWESOMETV_HOST_PORT=8409
# Image tag to run: latest, a release such as v0.1.4, or edge.
CHANNELLOOM_VERSION=latest

AWESOMETV_ADMIN_USER=admin
AWESOMETV_ADMIN_PASSWORD=change-me
# Comma-separated CIDRs allowed to reach Studio and the admin API. Empty = allow all.
# Example: 192.168.0.0/16,100.64.0.0/10
AWESOMETV_ADMIN_ALLOW_CIDRS=
# Requests per minute allowed for an API token. 0 disables the cap.
AWESOMETV_TOKEN_RATE_PER_MIN=600

# Optional OIDC single sign-on. Leave AWESOMETV_OIDC_ISSUER empty to disable.
# The issuer must serve /.well-known/openid-configuration over HTTPS.
AWESOMETV_OIDC_ISSUER=
AWESOMETV_OIDC_CLIENT_ID=
AWESOMETV_OIDC_CLIENT_SECRET=
AWESOMETV_OIDC_REDIRECT_URL=
AWESOMETV_OIDC_SCOPES=openid profile email
AWESOMETV_OIDC_ROLE_CLAIM=roles
AWESOMETV_OIDC_ADMIN_ROLE=admin
AWESOMETV_OIDC_OPERATOR_ROLE=operator
AWESOMETV_OIDC_VIEWER_ROLE=viewer
# viewer, operator, admin, or none to reject users without a mapped role.
AWESOMETV_OIDC_DEFAULT_ROLE=viewer
# Leave empty: links (M3U, HDHomeRun, Cast) follow the address each client used,
# so LAN, VPN and reverse-proxy clients all work. Set it only to force a single
# origin, for example https://tv.example.com behind a proxy.
AWESOMETV_PUBLIC_URL=
RUST_LOG=awesometv_server=info

# Optional Jellyfin metadata sync
JELLYFIN_URL=
JELLYFIN_API_KEY=

# Optional Emby metadata sync
EMBY_URL=
EMBY_API_KEY=

# Cloud sources
# Generate a 32-byte base64 key to keep secrets outside the data volume; otherwise
# data/secrets/cloud.key is generated automatically.
AWESOMETV_SECRET_KEY=
# Optional old key(s) for a one-restart rotation. Comma-separate multiple keys.
AWESOMETV_SECRET_KEY_PREVIOUS=
CLOUD_CACHE_MAX_GB=500
CLOUD_AUTO_CACHE_MAX_MB=2048

# Origin a Chromecast should fetch streams from. Empty = same origin the
# casting browser used. Set it when that origin is not reachable from the TV.
AWESOMETV_CAST_BASE_URL=
# Cap public stream video bitrate in kbps. 0 disables the cap.
AWESOMETV_STREAM_MAX_KBPS=900
# Per-client public request budgets, per minute. 0 disables a class.
AWESOMETV_RATE_LIMIT_ENABLED=true
AWESOMETV_RATE_LIMIT_API_PER_MIN=120
AWESOMETV_RATE_LIMIT_CAST_PER_MIN=20
AWESOMETV_RATE_LIMIT_PLAYLIST_PER_MIN=120
AWESOMETV_RATE_LIMIT_SEGMENT_PER_MIN=1800
AWESOMETV_RATE_LIMIT_STREAM_PER_MIN=12
# Long-lived MPEG-TS sessions. 0 disables the per-client cap.
AWESOMETV_MAX_CONCURRENT_STREAMS=4
AWESOMETV_MAX_STREAMS_PER_CLIENT=2
AWESOMETV_PRECACHE_ENABLED=true
AWESOMETV_PRECACHE_MAX_GB=100
AWESOMETV_PRECACHE_AHEAD_HOURS=24
AWESOMETV_PRECACHE_PROXY_KBPS=4000
AWESOMETV_PRECACHE_PROXY_HEIGHT=720
AWESOMETV_PRECACHE_COPY_MBPS=7
AWESOMETV_PRODUCER_MAX_LAG_SECONDS=0
# Default Media Receiver. Replace with a Styled or Custom receiver App ID.
AWESOMETV_CAST_RECEIVER_ID=CC1AD845
